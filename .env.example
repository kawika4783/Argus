NEXUSINTEL_ENV=development
NEXUSINTEL_SESSION_SECRET=replace-with-a-long-random-secret
NEXUSINTEL_DATABASE_URL=postgresql+psycopg://nexusintel:nexusintel@db:5432/nexusintel
NEXUSINTEL_DEMO_PASSWORD=change-me-locally
NEXUSINTEL_BOOTSTRAP_SECRET=generate-a-one-time-secret-on-the-server
NEXUSINTEL_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=/api
NEXUSINTEL_ZERO_COST_MODE=true
NEXUSINTEL_OLLAMA_BASE_URL=https://olli.ekahihub.com
NEXUSINTEL_OLLAMA_API_KEY=
NEXUSINTEL_OLLAMA_REQUEST_TIMEOUT_SECONDS=60
NEXUSINTEL_OLLAMA_DEFAULT_MODEL=qwen3:1.7b
NEXUSINTEL_OLLAMA_CONTEXT_LIMIT=4096
NEXUSINTEL_OPENAI_ENABLED=false
NEXUSINTEL_OPENAI_API_KEY=
NEXUSINTEL_OPENAI_BASE_URL=https://api.openai.com/v1
NEXUSINTEL_OPENAI_DEFAULT_MODEL=gpt-5-mini
NEXUSINTEL_OPENAI_SPENDING_LIMIT_USD=0
NEXUSINTEL_OPENAI_COST_PER_1K_TOKENS_USD=0

